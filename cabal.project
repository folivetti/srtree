packages: .
allow-newer: table-layout:*, haskeline:*, aeson:*

constraints:
    async >=2.2 && <2.3
  , binary >=0.8 && <0.9
  , deepseq >=1.4 && <1.6
  , directory >=1.3 && <1.4
  , exceptions >=0.10 && <0.11
  , hashable >=1.4 && <1.6
  , ieee754 >=0.8 && <0.9
  , lens >=5.0 && <6
  , parallel >=3.2 && <3.4
  , primitive >=0.8 && <0.10
  , statistics >=0.15 && <0.17
  , time >=1.9 && <1.15
  , unordered-containers >=0.2 && <0.3
  , optparse-applicative >=0.16 && <0.20
  , criterion >=1.5 && <2
  , HUnit >=1.6 && <1.7
  , mwc-random ==0.15.2.0

source-repository-package
    type: git
    location: https://github.com/haskell/mwc-random
    tag: 2cce257158befe52417433d1e7717f11ce718aec
